<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DefineConstants>$(DefineConstants);DESKTOP_SHARED</DefineConstants>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="../../../android/src/BlackEagle.Android/Assets/home-eagle.png" Link="Assets/home-eagle.png" />
    <Compile Include="../../../android/src/BlackEagle.Android/ConnectionFeedback.cs" Link="Mobile/ConnectionFeedback.cs" />
    <Compile Include="../../../android/src/BlackEagle.Android/CountryFlag.cs" Link="Mobile/CountryFlag.cs" />
    <Compile Include="../../../android/src/BlackEagle.Android/MobileText.cs" Link="Mobile/MobileText.cs" />
    <Compile Include="../../../android/src/BlackEagle.Android/MobileView.cs" Link="Mobile/MobileView.cs" />
    <PackageReference Include="Avalonia" Version="11.3.14" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.14" />
    <ProjectReference Include="../../../shared/BlackEagle.Client.Core/BlackEagle.Client.Core.csproj" />
  </ItemGroup>
</Project>
